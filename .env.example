# 이 파일을 복사해 .env 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env 는 git에 커밋하지 않습니다 (.gitignore 참고).

# 토스페이먼츠 클라이언트 키 (프론트엔드 빌드 시 사용)
# https://developers.tosspayments.com → 개발자센터 → 내 상점 → 클라이언트 키
# 테스트 키는 'test_ck_' 로 시작, 운영 키는 'live_ck_' 로 시작합니다.
VITE_TOSS_CLIENT_KEY=test_ck_여기에_클라이언트_키_입력

# 토스페이먼츠 시크릿 키 (백엔드에서 사용 — docker compose environment로 주입)
# 'test_sk_' 또는 'live_sk_' 로 시작합니다.
TOSS_SECRET_KEY=test_sk_여기에_시크릿_키_입력

# DB 비밀번호 (운영 배포 시 기본값 mins1234 대신 사용)
# DB_PASSWORD=강한_비밀번호_입력

# Azure Blob Storage (이미지 업로드)
# Azure Portal → Storage accounts → 해당 계정 → Access keys → Connection string 복사
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=여기에_계정명;AccountKey=여기에_키;EndpointSuffix=core.windows.net
# Azure Portal에서 미리 만든 컨테이너 이름 (기본값: product-images)
AZURE_STORAGE_CONTAINER_NAME=product-images
